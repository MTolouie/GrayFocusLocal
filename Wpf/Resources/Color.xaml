<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#121212"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#252526"/>
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#050505"/>

    <SolidColorBrush x:Key="AccentColorBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="AccentHoverColorBrush" Color="#1C97EA"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="SelectionBoxStrokeBrush" Color="#FF3333"/>

    <!-- Added Abort Button Colors -->
    <SolidColorBrush x:Key="AbortColorBrush" Color="#FF8C00"/>
    <!-- DarkOrange -->
    <SolidColorBrush x:Key="AbortHoverColorBrush" Color="#DC2626"/>
    <!-- Dark Red -->

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F1F1"/>
    <SolidColorBrush x:Key="SubtextBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="TerminalTextBrush" Color="#80FF80"/>
    <SolidColorBrush x:Key="StatusPanelBackgroundBrush" Color="#2D2D30"/>

    <!-- Color Palette -->
    <Color x:Key="WindowBgColor">#0F172A</Color>
    <Color x:Key="CardBgColor">#1E293B</Color>
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="AccentColor">#38BDF8</Color>
    <Color x:Key="MutedTextColor">#94A3B8</Color>

    <SolidColorBrush x:Key="LoadingWindowBackgroundBrush" Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="LoadingCardBackgroundBrush" Color="{StaticResource CardBgColor}"/>
    <SolidColorBrush x:Key="LoadingBorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="LoadingAccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="LoadingMutedTextBrush" Color="{StaticResource MutedTextColor}"/>

</ResourceDictionary>