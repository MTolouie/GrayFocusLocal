<Window x:Class="Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:Wpf"
        xmlns:helpers="clr-namespace:Wpf.Helpers"
        mc:Ignorable="d"
        Title="16-Bit Grayscale Pixel Range Scanner" 
        Height="800" Width="1100"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <helpers:DecimalTextBoxConverter x:Key="DecimalConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Margin="10" 
                Background="{StaticResource EditorBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="6">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Panel.ZIndex="10">
                    <TextBlock Text="{Binding ImageDisplayTitle}" 
                               Foreground="{StaticResource MutedTextBrush}" 
                               Style="{StaticResource SubHeaderTextStyle}"/>
                    <TextBlock Text="  |  (Use Mouse Wheel to Zoom In/Out)" 
                               Foreground="{StaticResource MutedTextBrush}" 
                               Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer x:Name="ImageScrollViewer"
                              HorizontalScrollBarVisibility="Hidden" 
                              VerticalScrollBarVisibility="Hidden"
                              helpers:ScrollViewerHelper.IsRightClickPanEnabled="True"
                              Margin="10,40,10,10">
                    <Grid>
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomScale}" 
                                            ScaleY="{Binding ZoomScale}"/>
                        </Grid.LayoutTransform>

                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top">

                            <Image x:Name="TargetImage"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   Source="{Binding ImagePath}" 
                                   Stretch="None">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SizeChanged">
                                        <i:InvokeCommandAction Command="{Binding UpdateRenderedBoundsCommand}" PassEventArgsToCommand="True"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Image>

                            <Canvas x:Name="SelectionCanvas" 
                                    Background="Transparent" 
                                    Width="{Binding ActualWidth, ElementName=TargetImage}" 
                                    Height="{Binding ActualHeight, ElementName=TargetImage}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDown">
                                        <i:InvokeCommandAction Command="{Binding CanvasMouseDownCommand}" PassEventArgsToCommand="True"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="MouseMove">
                                        <i:InvokeCommandAction Command="{Binding CanvasMouseMoveCommand}" PassEventArgsToCommand="True"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="MouseUp">
                                        <i:InvokeCommandAction Command="{Binding CanvasMouseUpCommand}"/>
                                    </i:EventTrigger>

                                    <i:EventTrigger EventName="PreviewMouseWheel">
                                        <i:InvokeCommandAction Command="{Binding CanvasMouseWheelCommand}" PassEventArgsToCommand="True"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Rectangle x:Name="SelectionRectangle"
                                           StrokeThickness="0.001"
                                           IsHitTestVisible="False"
                                           Style="{StaticResource SelectionBoxStyle}" 
                                           Width="{Binding RectWidth}"
                                           Height="{Binding RectHeight}"
                                           Visibility="{Binding RectVisibility}">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform X="{Binding RectLeft}" Y="{Binding RectTop}"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>

                                <Polygon x:Name="SelectionPolygon"
                                         Points="{Binding PolygonPoints}"
                                         Stroke="#22C55E" 
                                         StrokeThickness="{Binding PolygonStrokeThickness}"
                                         Fill="#3322C55E"
                                         IsHitTestVisible="False" 
                                         Visibility="{Binding PolygonVisibility}"/>

                                <Polyline x:Name="FreehandPolyline"
                                          Points="{Binding FreehandPoints}"
                                          Stroke="#F59E0B" 
                                          StrokeThickness="{Binding PolygonStrokeThickness}"
                                          Fill="{Binding FreehandFillBrush}"
                                          IsHitTestVisible="False" 
                                          Visibility="{Binding FreehandVisibility}"/>

                                <Line X1="{Binding TempLineX1}" Y1="{Binding TempLineY1}"
                                      X2="{Binding TempLineX2}" Y2="{Binding TempLineY2}"
                                      Stroke="#22C55E" StrokeThickness="{Binding LineStrokeThickness}" StrokeDashArray="0.5 0.5"
                                      Opacity="0.5"
                                      IsHitTestVisible="False" 
                                      Visibility="{Binding TempLineVisibility}"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
        <Border Grid.Row="2" Grid.Column="0" Margin="5" 
                Background="{StaticResource EditorBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="6">
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Python API Execution Log" Style="{StaticResource SubHeaderTextStyle}" Margin="0,5,0,5"/>

                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding ExecutionLog}" 
                         Style="{StaticResource TerminalListBoxStyle}"/>
            </Grid>
        </Border>


        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" 
                      Background="{StaticResource SplitterBrush}"/>

        <Grid Grid.Column="2" Grid.RowSpan="3" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <StackPanel>

                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <ContentControl Content="{StaticResource ImageScanIcon}" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="PIPELINE CONFIGURATION" Style="{StaticResource HeaderTextStyle}"/>
                    </StackPanel>

                    <Button Content="Select Folder"
                            Command="{Binding SelectImageCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,0,0,15" Height="35"/>

                    <Border Style="{StaticResource CardPanelStyle}" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Selection Outline Control" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="Rectangle Box"
                                             IsChecked="{Binding IsRectangleMode, Mode=TwoWay}"
                                             Foreground="White" VerticalAlignment="Center"/>
                                <RadioButton Grid.Column="1" Content="Polygon Shape"
                                             IsChecked="{Binding IsPolygonMode, Mode=TwoWay}"
                                             Foreground="White" VerticalAlignment="Center"/>
                                <RadioButton Grid.Column="2" Content="Freehand Draw"
                                             IsChecked="{Binding IsFreehandMode, Mode=TwoWay}"
                                             Foreground="White" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Background="#EF4444" CornerRadius="4" Height="28">
                                <Button Content="Clear/Remove Shape"
                                        Command="{Binding RemoveShapeCommand}"
                                        Foreground="White"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#DC2626"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardPanelStyle}" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Selected Region Intensities" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,10"/>

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Preview Images to Return" 
                       Foreground="{StaticResource MutedTextBrush}" 
                       Style="{StaticResource BodyTextStyle}" 
                       Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PreviewCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderBrush}"
                     Padding="5" Height="30" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <Button Content="Scan Target Region"
                Command="{Binding SendImageCommand}"
                Style="{StaticResource AccentButtonStyle}"
                Margin="0,0,0,15" Height="40"/>
                            <Button Content="Abort / Cancel Operation"
        Command="{Binding AbortProcessingCommand}"
        Style="{StaticResource AbortButtonStyle}"
        Height="40" 
        Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="5,0,5,0">
                                    <TextBlock Text="Min Value" Foreground="{StaticResource MutedTextBrush}" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedMinIntensity}"
                                               Foreground="#38BDF8"
                                               FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                    <TextBlock Text="Max Value" Foreground="{StaticResource MutedTextBrush}" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedMaxIntensity}"
                                               Foreground="#F43F5E"
                                               FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardPanelStyle}" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Geometric Imaging Parameters" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="4,0,4,0">
                                    <TextBlock Text="FOD (mm)" Foreground="{StaticResource MutedTextBrush}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FodValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource DecimalConverter}}"
                                             Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderBrush}"
                                             Padding="5" Height="30" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="FDD (mm)" Foreground="{StaticResource MutedTextBrush}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FddValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource DecimalConverter}}"
                                             Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderBrush}"
                                             Padding="5" Height="30" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                    <TextBlock Text="Pixel Size (µm)" Foreground="{StaticResource MutedTextBrush}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DetectorPixelSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource DecimalConverter}}"
                                             Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderBrush}"
                                             Padding="5" Height="30" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding CalculatedResolutionMessage}"
                                       Foreground="#38BDF8" Style="{StaticResource BodyTextStyle}"
                                       Margin="4,10,0,0" FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding CalculatedVolumeMessage}"
                                       Foreground="#34D399" Style="{StaticResource BodyTextStyle}"
                                       Margin="4,4,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource StatusPanelStyle}" Margin="0,15,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{StaticResource StatusSpinnerIcon}" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentStatusMessage}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyTextStyle}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
